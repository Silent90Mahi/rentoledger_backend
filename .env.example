# RentOLedger API configuration.
# Copy to `.env` and adjust. Real environment variables always override this file.
# For local development every value is optional: `npm run dev` starts a local
# MongoDB automatically and uses the development defaults below.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1

# --- Database (MongoDB 6.0+, replica set) -------------------------------------
# Transactions require a replica set: MongoDB Atlas, a self-hosted replica set,
# or a single-node replica set (`mongod --replSet rs0` + `rs.initiate()`).
# Leave unset in development to use the local replica set in ./.data/mongo.
# MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=rentoledger
MONGODB_POOL_MAX=20

# --- Secrets (required in production) --------------------------------------
# Generate each with: openssl rand -hex 32
# JWT_ACCESS_SECRET=
# OTP_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- OTP sign-in -------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Codes per phone number per hour. Default: 6 in production, 60 otherwise.
# OTP_MAX_PER_HOUR=6
# Fixed code for local testing only (rejected in production). `npm run dev` uses 123456.
# DEV_OTP_CODE=123456
# Development only: return the code in the API response when SMS_PROVIDER=console.
EXPOSE_DEV_OTP=true

# --- SMS delivery ------------------------------------------------------------
# console = print codes to the log (development); twilio = real SMS.
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15005550006
ALLOW_CONSOLE_SMS_IN_PRODUCTION=false

# --- HTTP ----------------------------------------------------------------------
# Browser origins allowed to call the API (comma separated).
# Unset: any localhost origin in development, none in production.
# CORS_ORIGINS=https://app.example.com
# Set to 1 (or true) behind a load balancer / reverse proxy so client IPs are correct.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1500
# Auth requests per window per IP. Default: 30 in production, 300 otherwise.
# AUTH_RATE_LIMIT_MAX=30

# --- Logging -------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
# LOG_PRETTY=false

# --- Background jobs -------------------------------------------------------------
# Rent entry generation, due/overdue reminders and token cleanup.
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=30

# --- Defaults for new accounts ---------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=+91
