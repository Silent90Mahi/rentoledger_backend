{
  "name": "rentoledger-api",
  "version": "1.0.0",
  "private": true,
  "description": "RentOLedger REST API - property, tenant and rent management backend",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/with-dev-db.ts src/db/cli.ts migrate",
    "db:rollback": "tsx scripts/with-dev-db.ts src/db/cli.ts rollback",
    "db:seed": "tsx scripts/with-dev-db.ts src/db/cli.ts seed",
    "db:reset": "tsx scripts/with-dev-db.ts src/db/cli.ts reset",
    "jobs:run": "tsx scripts/with-dev-db.ts src/jobs/run-once.ts",
    "migrate:prod": "node dist/src/db/cli.js migrate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
